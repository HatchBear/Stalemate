import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon, IconKind } from "../icons.slint";
import { AppState, Tr, Check } from "../types.slint";
import { HText, BText, DText, PageTitle, PaperPanel, SectionHead, Divider, CheckStamp, OutcomeStamp, Btn, TextBox, ViewFrame, IconText, MarkProblem } from "../widgets.slint";

export component HomeView inherits ViewFrame {
    ScrollView {
        VerticalLayout {
            padding: 1.5rem;
            padding-top: 1rem;
            spacing: 1.5rem;
            alignment: start;
            PageTitle { text: Tr.t("home-title"); }

            PaperPanel {
                VerticalLayout {
                    padding: 1.25rem;
                    spacing: 0.75rem;
                    SectionHead { text: Tr.t("home-status-title"); }
                    HorizontalLayout {
                        spacing: 0.75rem;
                        Icon { kind: IconKind.info; y: 0.1rem; }
                        HText { text: AppState.phase-text; font-size: 1.125rem; }
                    }
                    MarkProblem { }
                }
            }

            PaperPanel {
                VerticalLayout {
                    padding: 1.25rem;
                    spacing: 0.75rem;
                    SectionHead { text: Tr.t("watch-title"); }
                    BText { text: Tr.t("watch-help"); color: Theme.paper-muted; }
                    HorizontalLayout {
                        spacing: 0.75rem;
                        watch-box := TextBox {
                            placeholder: Tr.t("watch-placeholder");
                            label: Tr.t("watch-title");
                            horizontal-stretch: 1;
                            accepted(t) => { AppState.watch-match(t); }
                        }
                        Btn { primary: true; label: Tr.t("watch-button"); clicked => { AppState.watch-match(watch-box.text); } }
                    }
                    if AppState.watch-error != "": IconText { kind: IconKind.fail; text: AppState.watch-error; }
                }
            }

            PaperPanel {
                VerticalLayout {
                    padding: 1.25rem;
                    spacing: 0.7rem;
                    SectionHead { text: Tr.t("home-checks-title"); }
                    for check in AppState.checks: VerticalLayout {
                        spacing: 0.6rem;
                        HorizontalLayout {
                            spacing: 0.75rem;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                HText { text: check.label; font-weight: 600; }
                                if check.detail != "": BText { text: check.detail; color: Theme.paper-muted; }
                            }
                            CheckStamp { y: 0; state: check.state; }
                        }
                        Divider { }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Btn { label: Tr.t("home-open-setup"); clicked => { AppState.setup-open = true; } }
                    }
                }
            }

            PaperPanel {
                VerticalLayout {
                    padding: 1.25rem;
                    spacing: 0.75rem;
                    SectionHead { text: Tr.t("home-last-match-title"); }
                    if AppState.last-match.has-match: HorizontalLayout {
                        spacing: 1rem;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            HText { text: AppState.last-match.headline; font-size: 1.125rem; font-weight: 600; }
                            BText { text: AppState.last-match.detail; color: Theme.paper-muted; }
                        }
                        OutcomeStamp { outcome: AppState.last-match.outcome; y: 0; }
                    }
                    if !AppState.last-match.has-match: HorizontalLayout {
                        spacing: 0.75rem;
                        Icon { kind: IconKind.empty; }
                        BText { text: Tr.t("home-no-match"); }
                    }
                }
            }
        }
    }
}
