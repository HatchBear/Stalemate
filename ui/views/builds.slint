import { ScrollView, ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon, IconKind } from "../icons.slint";
import { AppState, Tr, DataKind, BuildsTab, ItemChipUi, SectionUi } from "../types.slint";
import { HText, BText, DText, PageTitle, Panel, PaperPanel, ParchmentCard, SectionHead, Divider, FormRow, Stamp, CatTag, TileGrid, Btn, TextBox, ViewFrame, StateBar, IconText } from "../widgets.slint";

// The category mix of a build ("Weapon 5", stamped tags) and its sections, every item a shop tile.
component BuildItems inherits VerticalLayout {
    in property <[ItemChipUi]> mix;
    in property <[SectionUi]> sections;
    spacing: 0.4rem;
    HorizontalLayout {
        spacing: 0.35rem;
        alignment: start;
        for m in root.mix: CatTag { chip: m; y: 0; }
    }
    for sec in root.sections: VerticalLayout {
        spacing: 0.25rem;
        if sec.title != "": HText { text: sec.title; color: Theme.ink; font-size: 0.875rem; font-weight: 700; wrap: no-wrap; overflow: elide; }
        TileGrid { items: sec.items; per-row: 6; }
    }
}

component Library inherits VerticalLayout {
    spacing: 0.5rem;
    alignment: start;
    property <bool> content-visible: AppState.builds-state.kind == DataKind.loaded || AppState.builds-state.kind == DataKind.stale;
    StateBar {
        state: AppState.builds-state;
        empty-text: Tr.t("builds-empty");
        retry => { AppState.retry(4); }
    }
    if root.content-visible: VerticalLayout {
        spacing: 0.5rem;
        if AppState.library.length > 0: HorizontalLayout {
            alignment: start;
            Stamp { text: AppState.library-count-text; has-icon: true; kind: IconKind.info; }
        }
        if AppState.library.length == 0: Panel {
            VerticalLayout {
                padding: 0.9rem;
                IconText { kind: IconKind.empty; text: Tr.t("builds-empty"); }
            }
        }
        for b in AppState.library: ParchmentCard {
            HorizontalLayout {
                padding: 1rem;
                spacing: 0.75rem;
                VerticalLayout {
                    horizontal-stretch: 1;
                    preferred-width: 1px;
                    HText { text: b.name; color: Theme.ink; font-size: 1.125rem; font-weight: 700; }
                    BText { text: b.hero; color: Theme.ink; }
                    BText { text: b.meta; color: Theme.ink; font-size: 0.8125rem; }
                    if b.flag != "": IconText { kind: IconKind.error; tint: Theme.danger; text-color: Theme.ink; text: b.flag; }
                    Rectangle { height: 0.4rem; }
                    BuildItems { mix: b.mix; sections: b.sections; }
                }
                if b.active: VerticalLayout {
                    alignment: start;
                    Stamp {
                        has-icon: true;
                        kind: IconKind.pass;
                        text: Tr.t("builds-active");
                    }
                }
                if !b.active: VerticalLayout {
                    alignment: center;
                    Btn {
                        label: Tr.t("builds-set-active");
                        clicked => { AppState.set-active(b.id); }
                    }
                }
            }
        }
    }
}

component Import inherits VerticalLayout {
    spacing: 0.75rem;
    alignment: start;
    PaperPanel {
        VerticalLayout {
            padding: 1.25rem;
            spacing: 0.75rem;
            BText { text: Tr.t("import-intro"); }
            HorizontalLayout {
                spacing: 0.75rem;
                HText { text: Tr.t("import-hero"); font-weight: 600; vertical-alignment: center; }
                ComboBox {
                    model: AppState.heroes;
                    current-index <=> AppState.import-hero;
                    horizontal-stretch: 1;
                    accessible-label: Tr.t("import-hero");
                }
                Btn { primary: true; label: Tr.t("import-search"); clicked => { AppState.search-community(AppState.import-hero); } }
            }
        }
    }
    StateBar {
        state: AppState.community-state;
        empty-text: Tr.t("import-empty");
        retry => { AppState.search-community(AppState.import-hero); }
    }
    for r[i] in AppState.community-rows: ParchmentCard {
        HorizontalLayout {
            padding: 1rem;
            spacing: 0.75rem;
            VerticalLayout {
                horizontal-stretch: 1;
                preferred-width: 1px;
                HText { text: r.name; color: Theme.ink; font-size: 1.125rem; font-weight: 700; }
                BText { text: r.hero; color: Theme.ink; }
                BText { text: r.usage; color: Theme.ink; font-size: 0.8125rem; }
                Rectangle { height: 0.4rem; }
                BuildItems { mix: r.mix; sections: r.sections; }
            }
            VerticalLayout {
                alignment: center;
                Btn { primary: true; label: Tr.t("import-button"); clicked => { AppState.import-community(i); } }
            }
        }
    }
}

component Builder inherits VerticalLayout {
    spacing: 1rem;
    alignment: start;
    PaperPanel {
        VerticalLayout {
            padding: 1.25rem;
            spacing: 0.75rem;
            FormRow {
                label: Tr.t("builder-hero");
                ComboBox {
                    model: AppState.heroes;
                    current-index <=> AppState.builder-hero;
                    min-width: 14rem;
                    accessible-label: Tr.t("builder-hero");
                }
            }
            TextBox {
                text <=> AppState.builder-name;
                placeholder: Tr.t("builder-name-placeholder");
                label: Tr.t("builder-name-placeholder");
            }
            for sec[si] in AppState.builder-sections: Panel {
                background: AppState.builder-target == si ? Theme.raised : Theme.panel;
                border-width: AppState.builder-target == si ? 3px : 1px;
                VerticalLayout {
                    padding: 0.8rem;
                    spacing: 0.5rem;
                    HorizontalLayout {
                        spacing: 0.5rem;
                        TextBox {
                            text: sec.title;
                            placeholder: Tr.t("builder-section-placeholder");
                            label: Tr.t("builder-section-placeholder");
                            horizontal-stretch: 1;
                            edited(t) => { AppState.builder-rename-section(si, t); }
                        }
                        Btn {
                            label: AppState.builder-target == si ? Tr.t("builder-target-on") : Tr.t("builder-target");
                            selected: AppState.builder-target == si;
                            clicked => { AppState.builder-target = si; }
                        }
                    }
                    if sec.items.length == 0: BText { text: Tr.t("builder-section-empty"); }
                    TileGrid {
                        items: sec.items;
                        per-row: 6;
                        mode: 1;
                        move-earlier-label: Tr.t("builder-move-up");
                        move-later-label: Tr.t("builder-move-down");
                        remove-label: Tr.t("builder-remove");
                        move(ii, dir) => { AppState.builder-move-item(si, ii, dir); }
                        remove(ii) => { AppState.builder-remove-item(si, ii); }
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                Btn { label: Tr.t("builder-add-section"); clicked => { AppState.builder-add-section(); } }
            }
        }
    }

    PaperPanel {
        VerticalLayout {
            padding: 1.25rem;
            spacing: 0.6rem;
            SectionHead { text: Tr.t("builder-search-title"); }
            TextBox {
                placeholder: Tr.t("builder-search-placeholder");
                label: Tr.t("builder-search-placeholder");
                edited(t) => { AppState.builder-search(t); }
                accepted(t) => { AppState.builder-search(t); }
            }
            TileGrid {
                items: AppState.builder-results;
                per-row: 6;
                mode: 2;
                add-label: Tr.t("builder-add-item");
                add(i) => { AppState.builder-add-item(i); }
            }
        }
    }

    PaperPanel {
        VerticalLayout {
            padding: 1.25rem;
            spacing: 0.6rem;
            SectionHead { text: Tr.t("builder-ability-title"); }
            TextBox {
                text <=> AppState.builder-ability;
                placeholder: Tr.t("builder-ability-placeholder");
                label: Tr.t("builder-ability-title");
            }
            // On paper the error icon is cream: the warning red is below 3:1 on paper.
            if AppState.builder-error != "": IconText { kind: IconKind.error; text: AppState.builder-error; }
            HorizontalLayout {
                alignment: start;
                Btn { primary: true; label: Tr.t("builder-save"); clicked => { AppState.builder-save(); } }
            }
        }
    }
}

export component BuildsView inherits ViewFrame {
    ScrollView {
        VerticalLayout {
            padding: 1.5rem;
            padding-top: 1rem;
            spacing: 1rem;
            alignment: start;
            PageTitle { text: Tr.t("builds-title"); }
            if AppState.builds-tab == BuildsTab.library: Library { }
            if AppState.builds-tab == BuildsTab.community: Import { }
            if AppState.builds-tab == BuildsTab.builder: Builder { }
        }
    }
}
